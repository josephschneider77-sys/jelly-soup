{
  "name": "jelly_baby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src scripts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "build:model": "node scripts/build-model.mjs",
    "build:environment": "node --experimental-strip-types scripts/build-studio-environment.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "test": "node scripts/test-suite.mjs",
    "test:physics": "node --experimental-strip-types scripts/verify-physics.mjs",
    "test:multitouch": "node --experimental-strip-types scripts/verify-multitouch.mjs",
    "test:orientation": "node --experimental-strip-types scripts/verify-orientation.mjs",
    "test:deformation": "node --experimental-strip-types scripts/verify-deformation.mjs",
    "test:input": "node --experimental-strip-types scripts/verify-input.mjs",
    "test:bath": "node --experimental-strip-types scripts/verify-bath.mjs",
    "build": "node scripts/ensure-built-assets.mjs && tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/delaunator": "^5.0.3",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "three": "^0.185.0"
  }
}
